@model List<project_photo_sharing.Models.PhotoPost>
@{
    Layout = null;
    int currentUserId = 1;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PixelShare - Photo Sharing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <nav class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3">
        <div class="max-w-5xl mx-auto flex items-center justify-between">
            <a href="@Url.Action("Index", "Home")" class="flex items-center gap-2 text-2xl font-bold text-indigo-600">
                <i class="fa-solid fa-camera-retro"></i> PixelShare
            </a>
            <div class="flex items-center gap-4">
                <button onclick="toggleModal()" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-full text-sm font-medium transition shadow-sm">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Đăng ảnh mới
                </button>
                <div class="flex items-center gap-2">
                    <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100" class="w-9 h-9 rounded-full object-cover border border-slate-300">
                    <span class="text-sm font-semibold">ban_cua_toi</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-6 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
            @foreach (var post in Model)
            {
                <article class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="@post.Author.AvatarUrl" class="w-10 h-10 rounded-full object-cover">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-semibold text-sm">@post.Author.Username</h3>
                                    @if (post.UserId != currentUserId)
                                    {
                                        <span class="text-slate-300">•</span>
                                        <form action="@Url.Action("ToggleFollow", "Home")" method="post" class="inline">
                                            <input type="hidden" name="targetUserId" value="@post.UserId" />
                                            <button type="submit" class="text-xs font-semibold @(post.IsFollowedByCurrentUser ? "text-slate-500" : "text-indigo-600")">
                                                @(post.IsFollowedByCurrentUser ? "Đang theo dõi" : "+ Theo dõi")
                                            </button>
                                        </form>
                                    }
                                </div>
                                <p class="text-xs text-slate-400">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>

                        @if (post.UserId == currentUserId)
                        {
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="document.getElementById('edit-box-@post.PostId').classList.toggle('hidden')"
                                        class="text-xs bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 px-3 py-1.5 rounded-lg font-medium">
                                    <i class="fa-solid fa-pen"></i> Sửa
                                </button>
                                <form action="@Url.Action("DeletePost", "Home")" method="post"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                    <input type="hidden" name="postId" value="@post.PostId" />
                                    <button type="submit" class="text-xs bg-rose-50 hover:bg-rose-100 text-rose-600 px-3 py-1.5 rounded-lg font-medium">
                                        <i class="fa-solid fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    @if (post.UserId == currentUserId)
                    {
                        <div id="edit-box-@post.PostId" class="hidden bg-indigo-50/50 px-4 py-3 border-y border-indigo-100">
                            <form action="@Url.Action("EditPost", "Home")" method="post" enctype="multipart/form-data" class="space-y-3">
                                <input type="hidden" name="postId" value="@post.PostId" />
                                <div>
                                    <label class="block text-xs font-semibold text-slate-600 mb-1">Sửa Caption:</label>
                                    <input type="text" name="newCaption" value="@post.Caption" required class="w-full text-sm bg-white border border-slate-300 rounded-lg px-3 py-1.5" />
                                </div>
                                <div class="flex items-center justify-between gap-2">
                                    <div class="text-xs text-slate-500">
                                        <label class="font-semibold block mb-1">Thay ảnh mới (tùy chọn):</label>
                                        <input type="file" name="newImageFile" accept="image/*" class="text-xs" />
                                    </div>
                                    <button type="submit" class="bg-indigo-600 text-white text-xs font-semibold px-4 py-2 rounded-lg">Lưu cập nhật</button>
                                </div>
                            </form>
                        </div>
                    }

                    <div class="bg-slate-900 max-h-[500px] flex items-center justify-center overflow-hidden">
                        <img src="@post.ImageUrl" class="w-full h-auto object-cover" />
                    </div>

                    <div class="p-4">
                        <div class="text-sm mb-3">
                            <span class="font-semibold mr-2">@post.Author.Username</span>
                            <span>@post.Caption</span>
                        </div>

                        <div class="border-t border-slate-100 pt-3 mt-3">
                            <p class="text-xs text-slate-400 mb-2">Bình luận (@(post.Comments != null ? post.Comments.Count : 0))</p>
                            <div class="space-y-2 max-h-36 overflow-y-auto mb-3 text-sm">
                                @if (post.Comments != null)
                                {
                                    foreach (var cmt in post.Comments)
                                    {
                                        <div class="flex gap-2">
                                            <span class="font-semibold">@cmt.User.Username:</span>
                                            <span class="text-slate-600">@cmt.Content</span>
                                        </div>
                                    }
                                }
                            </div>

                            <form action="@Url.Action("AddComment", "Home")" method="post" class="flex items-center gap-2 border-t border-slate-100 pt-3">
                                <input type="hidden" name="postId" value="@post.PostId" />
                                <input type="text" name="content" placeholder="Viết bình luận..." required class="w-full text-sm outline-none bg-transparent" />
                                <button type="submit" class="text-indigo-600 font-semibold text-sm">Gửi</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="hidden lg:block">
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm sticky top-20 space-y-3">
                <h4 class="font-bold text-sm text-slate-700">PixelShare App</h4>
                <p class="text-xs text-slate-500">Đã kết nối cơ sở dữ liệu SQL Server thành công.</p>
            </div>
        </div>
    </main>

    <div id="upload-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full overflow-hidden shadow-xl">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h3 class="font-bold text-lg">Đăng ảnh mới</h3>
                <button onclick="toggleModal()" class="text-slate-400 hover:text-slate-600 text-xl"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form action="@Url.Action("UploadPhoto", "Home")" method="post" enctype="multipart/form-data" class="p-6 space-y-4">
                <div class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center cursor-pointer" onclick="document.getElementById('file-input').click()">
                    <input type="file" name="imageFile" id="file-input" accept="image/*" class="hidden" onchange="previewImg(event)" required />
                    <div id="placeholder">
                        <i class="fa-regular fa-image text-4xl text-slate-400 mb-2"></i>
                        <p class="text-sm font-medium text-slate-600">Chọn file ảnh từ máy tính</p>
                    </div>
                    <img id="preview" class="hidden max-h-60 mx-auto rounded-lg object-contain" />
                </div>
                <div>
                    <textarea name="caption" rows="3" placeholder="Nhập chú thích (Caption)..." required class="w-full border border-slate-200 rounded-xl p-3 text-sm outline-none"></textarea>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" onclick="toggleModal()" class="px-4 py-2 rounded-xl text-sm text-slate-600">Hủy</button>
                    <button type="submit" class="px-6 py-2 rounded-xl text-sm bg-indigo-600 text-white">Tải lên</button>
                </div>
            </form>
        </div>
    </div>

    <script>
                function toggleModal() {
                    const modal = document.getElementById('upload-modal');
                    modal.classList.toggle('hidden');
                    modal.classList.toggle('flex');
                }
                function previewImg(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const preview = document.getElementById('preview');
                        preview.src = URL.createObjectURL(file);
                        preview.classList.remove('hidden');
                        document.getElementById('placeholder').classList.add('hidden');
                    }
                }
    </script>
</body>
</html>